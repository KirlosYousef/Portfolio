---
import { getCollection } from 'astro:content';
import AdditionalProducts from '@/components/AdditionalProducts.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const featuredWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Selected Software Engineering Work — Kirlos Yousef"
  description="Case studies across AI applications, iOS products, web systems, backend services, mobility, and independent product engineering."
>
  <section class="page-hero">
    <div class="container-wide page-hero__grid">
      <div data-reveal>
        <p class="eyebrow">Work · 11 selected products</p>
        <h1>Selected work across <em>AI and iOS.</em></h1>
      </div>
      <div class="page-hero__aside" data-reveal>
        <p>
          Browse case studies relevant to the role or project you’re considering. Each one explains
          my contribution, key engineering decisions, and measurable outcomes.
        </p>
        <a class="text-link" href="mailto:kirlosy@icloud.com"
          >Discuss a role or project <ArrowIcon /></a
        >
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="container-wide">
      <SectionIntro
        eyebrow="Detailed case studies"
        title="Choose the evidence that matches your role."
        description="Filter by specialization or browse the complete collection. Employer work and independent products are identified in every case study."
        theme="dark"
      />
      <div class="work-filters" aria-label="Filter case studies" data-work-filters>
        <button type="button" data-work-filter="all" aria-pressed="true">All work</button>
        <button type="button" data-work-filter="ai" aria-pressed="false">AI engineering</button>
        <button type="button" data-work-filter="ios" aria-pressed="false">iOS engineering</button>
        <span class="sr-only" aria-live="polite" data-filter-status>
          Showing all {featuredWork.length} case studies
        </span>
      </div>
      <div class="work-grid" data-work-grid>
        {
          featuredWork.map((project) => (
            <ProjectCard
              slug={project.id}
              title={project.data.shortTitle}
              eyebrow={project.data.eyebrow}
              summary={project.data.summary}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              accent={project.data.accent}
              order={project.data.order}
              platforms={project.data.platforms}
              tracks={project.data.tracks}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <SectionIntro
        eyebrow="Independent products · 3 more"
        title="Shipped, maintained, and available now."
        description="A focused selection of independent products that adds evidence of product ownership, monetization, engagement systems, and delivery beyond client work."
      />
      <AdditionalProducts />
    </div>
  </section>
</BaseLayout>
