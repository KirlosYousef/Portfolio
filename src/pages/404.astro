---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Kirlos Yousef"
  description="The page you requested could not be found."
>
  <section class="error-page">
    <div class="container">
      <p class="eyebrow">404 · Off route</p>
      <h1>404</h1>
      <p>
        This page took a different path. The selected work and the rest of the portfolio are still
        right where they should be.
      </p>
      <a class="button button--ink" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
