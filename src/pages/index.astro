---
import { getCollection } from 'astro:content';
import ArrowIcon from '@/components/ArrowIcon.astro';
import AppImage from '@/components/AppImage.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import { experience, profile, proofPoints, skillGroups } from '@/data/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';

const featuredWork = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero">
    <div class="container-wide hero__grid">
      <div class="hero__copy" data-reveal>
        <p class="hero__availability">{profile.availability}</p>
        <h1>Senior iOS Engineer. <em>Technical lead.</em></h1>
        <p class="hero__lead">{profile.introduction}</p>
        <div class="hero__actions">
          <a class="button" href="#selected-work">Explore selected work <ArrowIcon /></a>
          <a class="button button--ghost" href={profile.resume} target="_blank">View résumé</a>
          <a class="hero__email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
      </div>

      <div
        class="constellation"
        data-constellation
        aria-label="A selection of products Kirlos has built"
        data-reveal
      >
        <div class="app-orbit app-orbit--spookling">
          <AppImage src="/images/apps/Spookling.png" alt="Spookling" loading="eager" />
        </div>
        <div class="app-orbit app-orbit--raceme">
          <AppImage src="/images/apps/RaceMe.jpg" alt="RaceMe" loading="eager" />
        </div>
        <div class="app-orbit app-orbit--revera">
          <AppImage src="/images/apps/Revera.jpg" alt="Revera AI" loading="eager" />
        </div>
        <div class="app-orbit app-orbit--plot">
          <AppImage
            src="/images/apps/PlotMyCalories.jpg"
            alt="Plot My Calories AI"
            loading="eager"
          />
        </div>
        <div class="app-orbit app-orbit--sellou">
          <AppImage src="/images/apps/Sellou.jpg" alt="Sellou" loading="eager" />
        </div>
        <p class="constellation__label">
          Products across AI, mobility, health, voice, and real-time systems.
        </p>
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="Career highlights">
    <div class="container-wide proof-strip__grid">
      {
        proofPoints.map((point) => (
          <div class="proof-item" data-reveal>
            <strong>{point.value}</strong>
            <span>{point.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--night" id="selected-work">
    <div class="container-wide">
      <SectionIntro
        eyebrow="Selected work · 01"
        title="Products built for the moments that matter."
        description="From a runner’s locked screen to a multimodal checkout and a streamed AI response—each project pairs product judgment with dependable engineering."
        theme="dark"
      />
      <div class="work-grid">
        {
          featuredWork
            .slice(0, 4)
            .map((project) => (
              <ProjectCard
                slug={project.id}
                title={project.data.shortTitle}
                eyebrow={project.data.eyebrow}
                summary={project.data.summary}
                image={project.data.image}
                imageAlt={project.data.imageAlt}
                accent={project.data.accent}
                order={project.data.order}
                platforms={project.data.platforms}
              />
            ))
        }
      </div>
      <div class="section-action" data-reveal>
        <a class="button button--light" href="/work/">See all 10 selected products <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container experience-grid">
      <div class="experience-sticky" data-reveal>
        <p class="eyebrow">Leadership · 02</p>
        <h2>Engineering direction with delivery discipline.</h2>
        <p>
          I lead close to the work: setting architecture, improving team systems, and staying
          accountable for how the product feels in production.
        </p>
      </div>
      <div class="timeline" aria-label="Professional experience">
        {
          experience.map((role) => (
            <article class="timeline-item" data-reveal>
              <p class="timeline-item__period">{role.period}</p>
              <div>
                <h3>{role.title}</h3>
                <p class="timeline-item__company">
                  {role.company} · {role.descriptor}
                </p>
                <p class="timeline-item__location">{role.location}</p>
                <ul>
                  {role.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="portrait-frame" data-reveal>
          <AppImage
            src="/images/kirlos-yousef.jpg"
            alt="Kirlos Yousef smiling with his arms folded"
            kind="portrait"
          />
        </div>
        <div class="about-copy" data-reveal>
          <p class="eyebrow">About · 03</p>
          <h2>Calm systems. <em>Ambitious products.</em></h2>
          <p class="about-copy__lead">{profile.about}</p>
          <div class="education-note">
            <strong>B.S. Computer Science · University of Debrecen</strong>
            <span>2017 — 2020</span>
            <span>Graduated first in cohort · Fully funded scholarship</span>
            <span>Debrecen, Hungary</span>
          </div>
        </div>
      </div>

      <div class="skills-grid" aria-label="Technical capabilities">
        {
          skillGroups.map((group) => (
            <article class="skill-group" data-reveal>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide contact-panel" data-reveal>
      <div class="contact-panel__content">
        <p class="eyebrow">Open to the right challenge</p>
        <h2>Building an iOS product where reliability is part of the experience?</h2>
        <p>
          I'm based in Egypt and open to remote work or relocation. Let’s talk about the product,
          the team, and the systems that will help both succeed.
        </p>
        <div class="contact-panel__actions">
          <a class="button button--light" href={`mailto:${profile.email}`}
            >Start a conversation <ArrowIcon /></a
          >
          <a class="contact-panel__link" href={profile.linkedin} target="_blank" rel="noreferrer"
            >LinkedIn ↗</a
          >
          <a class="contact-panel__link" href={profile.github} target="_blank" rel="noreferrer"
            >GitHub ↗</a
          >
          <a class="contact-panel__link" href={profile.resume} target="_blank">Résumé ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
