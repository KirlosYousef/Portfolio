---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader/wght-italic.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { profile } from '@/data/profile';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
  pageTrack?: 'ai' | 'ios';
}

const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.introduction,
  image = '/og-image.png',
  type = 'website',
  schema,
  pageTrack,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Senior Software Engineer',
  url: profile.website,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'Egypt' },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: [
    'iOS',
    'Swift',
    'SwiftUI',
    'Python',
    'FastAPI',
    'LLM applications',
    'Retrieval-augmented generation',
    'Software evaluation',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#06070a" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://apps.apple.com" />
    <title>{title}</title>
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Kirlos Yousef" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <ClientRouter />
    <script is:inline>
      // Effects tier: "full" by default, "lite" on low-power setups (reduced motion,
      // Save-Data, very low-end hardware, software rendering, or a slow frame-rate
      // probe). Lite drops page transitions and heavy effects, never content.
      // Override: ?fx=lite|full on the URL, or localStorage.fx.
      (() => {
        const root = document.documentElement;
        const read = (key) => {
          try {
            return sessionStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const write = (key, value) => {
          try {
            sessionStorage.setItem(key, value);
          } catch {
            /* storage unavailable: detect again next page */
          }
        };
        let forced = new URLSearchParams(location.search).get('fx');
        if (!forced) {
          try {
            forced = localStorage.getItem('fx');
          } catch {
            forced = null;
          }
        }
        const lowPowerReason = () => {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return 'reduced-motion';
          if (navigator.connection && navigator.connection.saveData) return 'save-data';
          if (navigator.deviceMemory && navigator.deviceMemory <= 2) return 'low-memory';
          if (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2)
            return 'few-cores';
          try {
            const gl = document.createElement('canvas').getContext('webgl');
            const info = gl && gl.getExtension('WEBGL_debug_renderer_info');
            const renderer = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
            if (/swiftshader|llvmpipe|softpipe|software|basic render/i.test(renderer)) {
              return 'software-renderer';
            }
          } catch {
            /* no WebGL: nothing to infer */
          }
          return null;
        };
        const apply = (tier, reason) => {
          window.__fx = tier;
          document.documentElement.dataset.fx = tier;
          document.documentElement.dataset.fxReason = reason || '';
          if (tier === 'lite') {
            // Without this marker Astro's router does plain page loads (no view transitions).
            document.querySelector('meta[name="astro-view-transitions-enabled"]')?.remove();
          }
        };

        const cached = read('fx-tier');
        let tier = 'full';
        let reason = '';
        if (forced === 'lite' || forced === 'full') {
          tier = forced;
          reason = 'forced';
        } else if (cached) {
          [tier, reason] = cached.split(':');
        } else {
          reason = lowPowerReason();
          tier = reason ? 'lite' : 'full';
          write('fx-tier', `${tier}:${reason || ''}`);
        }
        apply(tier, reason);
        // Astro replaces <html> attributes when it swaps pages.
        document.addEventListener('astro:after-swap', () =>
          apply(window.__fx, root.dataset.fxReason),
        );

        // Self-healing guard: if snapshotting the page for a transition takes too long,
        // the device cannot afford transitions. Drop to lite for the rest of the session.
        let preparedAt = 0;
        document.addEventListener('astro:after-preparation', () => {
          preparedAt = performance.now();
        });
        document.addEventListener('astro:before-swap', () => {
          if (
            preparedAt &&
            window.__fx === 'full' &&
            !forced &&
            performance.now() - preparedAt > 1500
          ) {
            write('fx-tier', 'lite:slow-transition');
            apply('lite', 'slow-transition');
          }
          preparedAt = 0;
        });

        // Capable-looking device: confirm with a short frame-rate probe, once per session.
        if (tier === 'full' && !forced && !read('fx-probed')) {
          const probe = () => {
            if (document.hidden) {
              document.addEventListener('visibilitychange', probe, { once: true });
              return;
            }
            const deltas = [];
            let last = performance.now();
            const step = (now) => {
              if (document.hidden) return;
              deltas.push(now - last);
              last = now;
              if (deltas.length < 48) {
                requestAnimationFrame(step);
                return;
              }
              const settled = deltas.slice(3).sort((x, y) => x - y);
              write('fx-probed', '1');
              if (settled[settled.length >> 1] > 34) {
                write('fx-tier', 'lite:slow-frames');
                apply('lite', 'slow-frames');
              }
            };
            requestAnimationFrame(step);
          };
          addEventListener('load', () => setTimeout(probe, 1200), { once: true });
        }
      })();
    </script>
  </head>
  <body data-page-track={pageTrack}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true" data-cursor-glow transition:persist></div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      const setupPortfolioUI = () => {
        type PortfolioWindow = Window & { portfolioUIController?: AbortController };
        const portfolioWindow = window as PortfolioWindow;
        portfolioWindow.portfolioUIController?.abort();
        const controller = new AbortController();
        portfolioWindow.portfolioUIController = controller;
        const { signal } = controller;

        const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
        const nav = document.querySelector<HTMLElement>('[data-nav]');

        const closeMenu = () => {
          menuButton?.setAttribute('aria-expanded', 'false');
          nav?.removeAttribute('data-open');
          document.body.classList.remove('menu-open');
        };

        menuButton?.addEventListener(
          'click',
          () => {
            const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
            menuButton.setAttribute('aria-expanded', String(!isOpen));
            nav?.toggleAttribute('data-open', !isOpen);
            document.body.classList.toggle('menu-open', !isOpen);
          },
          { signal },
        );

        nav
          ?.querySelectorAll('a')
          .forEach((link) => link.addEventListener('click', closeMenu, { signal }));
        window.addEventListener('keydown', (event) => event.key === 'Escape' && closeMenu(), {
          signal,
        });

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealItems.forEach((item) => item.setAttribute('data-visible', ''));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  (entry.target as HTMLElement).setAttribute('data-visible', '');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          signal.addEventListener('abort', () => observer.disconnect(), { once: true });
          revealItems.forEach((item) => observer.observe(item));
        }

        const constellation = document.querySelector<HTMLElement>('[data-constellation]');
        if (constellation && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
          let bounds = constellation.getBoundingClientRect();
          let pointerX = 0;
          let pointerY = 0;
          let animationFrame = 0;

          const renderPointerDepth = () => {
            constellation.style.setProperty('--pointer-x', String(pointerX));
            constellation.style.setProperty('--pointer-y', String(pointerY));
            animationFrame = 0;
          };

          const schedulePointerDepth = () => {
            if (!animationFrame) animationFrame = window.requestAnimationFrame(renderPointerDepth);
          };

          constellation.addEventListener(
            'pointerenter',
            () => {
              bounds = constellation.getBoundingClientRect();
            },
            { signal },
          );
          constellation.addEventListener(
            'pointermove',
            (event) => {
              pointerX = (event.clientX - bounds.left) / bounds.width - 0.5;
              pointerY = (event.clientY - bounds.top) / bounds.height - 0.5;
              schedulePointerDepth();
            },
            { passive: true, signal },
          );
          constellation.addEventListener(
            'pointerleave',
            () => {
              pointerX = 0;
              pointerY = 0;
              schedulePointerDepth();
            },
            { signal },
          );
          signal.addEventListener(
            'abort',
            () => {
              if (animationFrame) window.cancelAnimationFrame(animationFrame);
            },
            { once: true },
          );
        }

        if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
          document.querySelectorAll<HTMLElement>('[data-depth]').forEach((surface) => {
            surface.addEventListener(
              'pointermove',
              (event) => {
                const bounds = surface.getBoundingClientRect();
                surface.style.setProperty(
                  '--depth-x',
                  String((event.clientX - bounds.left) / bounds.width - 0.5),
                );
                surface.style.setProperty(
                  '--depth-y',
                  String((event.clientY - bounds.top) / bounds.height - 0.5),
                );
              },
              { passive: true, signal },
            );
            surface.addEventListener(
              'pointerleave',
              () => {
                surface.style.setProperty('--depth-x', '0');
                surface.style.setProperty('--depth-y', '0');
              },
              { signal },
            );
          });
        }

        const filterGroup = document.querySelector<HTMLElement>('[data-work-filters]');
        const projectCards = document.querySelectorAll<HTMLElement>('[data-project-card]');
        const filterStatus = document.querySelector<HTMLElement>('[data-filter-status]');
        filterGroup?.querySelectorAll<HTMLButtonElement>('[data-work-filter]').forEach((button) => {
          button.addEventListener(
            'click',
            () => {
              const filter = button.dataset.workFilter ?? 'all';
              let visibleCount = 0;
              filterGroup
                .querySelectorAll<HTMLButtonElement>('[data-work-filter]')
                .forEach((candidate) =>
                  candidate.setAttribute('aria-pressed', String(candidate === button)),
                );
              projectCards.forEach((card) => {
                const visible =
                  filter === 'all' || card.dataset.tracks?.split(' ').includes(filter);
                card.hidden = !visible;
                if (visible) visibleCount += 1;
              });
              if (filterStatus) {
                const label = filter === 'all' ? 'all' : filter.toUpperCase();
                filterStatus.textContent = `Showing ${visibleCount} ${label} case studies`;
              }
            },
            { signal },
          );
        });

        const finePointer = window.matchMedia('(pointer: fine)').matches;

        // Spotlight surfaces follow the pointer.
        if (finePointer) {
          document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((surface) => {
            surface.addEventListener(
              'pointermove',
              (event) => {
                const bounds = surface.getBoundingClientRect();
                surface.style.setProperty('--mx', `${event.clientX - bounds.left}px`);
                surface.style.setProperty('--my', `${event.clientY - bounds.top}px`);
              },
              { passive: true, signal },
            );
          });
        }

        // Magnetic buttons.
        if (finePointer && !reduceMotion) {
          document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((button) => {
            button.addEventListener(
              'pointermove',
              (event) => {
                const bounds = button.getBoundingClientRect();
                const x = event.clientX - bounds.left - bounds.width / 2;
                const y = event.clientY - bounds.top - bounds.height / 2;
                button.style.transform = `translate(${x * 0.18}px, ${y * 0.28}px)`;
              },
              { passive: true, signal },
            );
            button.addEventListener(
              'pointerleave',
              () => {
                button.style.transform = '';
              },
              { signal },
            );
          });
        }

        // Cursor glow.
        const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
        if (glow && finePointer && !reduceMotion) {
          let targetX = window.innerWidth / 2;
          let targetY = window.innerHeight / 3;
          let currentX = targetX;
          let currentY = targetY;
          let glowFrame = 0;
          const moveGlow = () => {
            currentX += (targetX - currentX) * 0.14;
            currentY += (targetY - currentY) * 0.14;
            glow.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
            glowFrame =
              Math.abs(targetX - currentX) + Math.abs(targetY - currentY) > 0.5
                ? window.requestAnimationFrame(moveGlow)
                : 0;
          };
          window.addEventListener(
            'pointermove',
            (event) => {
              targetX = event.clientX;
              targetY = event.clientY;
              glow.setAttribute('data-active', '');
              if (!glowFrame) glowFrame = window.requestAnimationFrame(moveGlow);
            },
            { passive: true, signal },
          );
          document.documentElement.addEventListener(
            'pointerleave',
            () => glow.removeAttribute('data-active'),
            { signal },
          );
          signal.addEventListener('abort', () => window.cancelAnimationFrame(glowFrame), {
            once: true,
          });
        }

        // Count-up numbers keep their final text in the markup.
        const counters = document.querySelectorAll<HTMLElement>('[data-count]');
        if (!reduceMotion && 'IntersectionObserver' in window) {
          const countObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const element = entry.target as HTMLElement;
                countObserver.unobserve(element);
                const finalText = element.textContent ?? '';
                const match = finalText.match(/^([^\d]*)([\d.]+)(.*)$/);
                if (!match) return;
                const [, prefix = '', digits = '0', suffix = ''] = match;
                const target = Number(digits);
                const decimals = (digits.split('.')[1] ?? '').length;
                const started = performance.now();
                const duration = 1400;
                const tick = (now: number) => {
                  const progress = Math.min((now - started) / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 4);
                  element.textContent =
                    progress < 1
                      ? `${prefix}${(target * eased).toFixed(decimals)}${suffix}`
                      : finalText;
                  if (progress < 1 && !signal.aborted) window.requestAnimationFrame(tick);
                };
                window.requestAnimationFrame(tick);
              });
            },
            { threshold: 0.6 },
          );
          signal.addEventListener('abort', () => countObserver.disconnect(), { once: true });
          counters.forEach((counter) => countObserver.observe(counter));
        }

        // Local Cairo time.
        const clocks = document.querySelectorAll<HTMLTimeElement>('[data-clock]');
        if (clocks.length) {
          const formatter = new Intl.DateTimeFormat('en-GB', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'Africa/Cairo',
          });
          const renderClock = () =>
            clocks.forEach((clock) => {
              clock.textContent = formatter.format(new Date());
            });
          renderClock();
          const clockTimer = window.setInterval(renderClock, 30_000);
          signal.addEventListener('abort', () => window.clearInterval(clockTimer), { once: true });
        }

        // Signal field: a dot lattice that bends around the pointer.
        const canvas = document.querySelector<HTMLCanvasElement>('[data-signal-field]');
        const context = canvas?.getContext('2d');
        if (canvas && context) {
          const host = canvas.parentElement as HTMLElement;
          const trackColors: Record<string, [number, number, number]> = {
            ai: [168, 152, 255],
            ios: [255, 190, 102],
          };
          const [red, green, blue] = trackColors[document.body.dataset.pageTrack ?? ''] ?? [
            170, 190, 255,
          ];
          const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
          let width = 0;
          let height = 0;
          let gap = 30;
          let pointerFieldX = -9999;
          let pointerFieldY = -9999;
          let easedX = -9999;
          let easedY = -9999;
          let fieldFrame = 0;
          let inView = true;
          let lastDraw = 0;
          let lastPointerMove = 0;
          // Touch devices get a static frame: no pointer to follow, and it saves battery.
          const isLite = () => document.documentElement.dataset.fx === 'lite';
          const animate = finePointer && !reduceMotion && !isLite();

          const resize = () => {
            const bounds = host.getBoundingClientRect();
            width = bounds.width;
            height = bounds.height;
            gap = width < 700 ? 26 : 32;
            canvas.width = Math.round(width * ratio);
            canvas.height = Math.round(height * ratio);
            context.setTransform(ratio, 0, 0, ratio, 0, 0);
            if (!animate && !isLite()) draw(0);
          };

          const draw = (time: number) => {
            context.clearRect(0, 0, width, height);
            context.fillStyle = `rgb(${red} ${green} ${blue})`;
            const t = time * 0.00035;
            const radius = 170;
            for (let x = gap / 2; x < width; x += gap) {
              for (let y = gap / 2; y < height; y += gap) {
                const dx = x - easedX;
                const dy = y - easedY;
                const distance = Math.sqrt(dx * dx + dy * dy) || 1;
                const influence = Math.exp(-(distance * distance) / (2 * radius * radius));
                const wave = Math.sin(x * 0.011 + t * 2) * Math.cos(y * 0.013 - t * 1.6);
                const push = influence * 22;
                const px = x + (dx / distance) * push;
                const py = y + (dy / distance) * push + wave * 3;
                const size = 1 + influence * 2.2 + (wave + 1) * 0.25;
                context.globalAlpha = Math.min(0.1 + influence * 0.8 + (wave + 1) * 0.07, 1);
                context.fillRect(px - size / 2, py - size / 2, size, size);
              }
            }
            context.globalAlpha = 1;
          };

          const loop = (time: number) => {
            fieldFrame = 0;
            if (!inView || document.hidden || isLite()) return;
            easedX += (pointerFieldX - easedX) * 0.08;
            easedY += (pointerFieldY - easedY) * 0.08;
            // Full rate while the pointer moves; 30fps for the idle wave; paused under the menu.
            const interval = time - lastPointerMove < 2500 ? 0 : 33;
            if (!document.body.classList.contains('menu-open') && time - lastDraw >= interval) {
              draw(time);
              lastDraw = time;
            }
            fieldFrame = window.requestAnimationFrame(loop);
          };

          const start = () => {
            resize();
            if (!animate) return;
            if (!fieldFrame) fieldFrame = window.requestAnimationFrame(loop);
          };

          const idle =
            'requestIdleCallback' in window
              ? (callback: () => void) => window.requestIdleCallback(callback, { timeout: 1200 })
              : (callback: () => void) => window.setTimeout(callback, 400);
          idle(() => {
            if (!signal.aborted) start();
          });

          window.addEventListener('resize', resize, { passive: true, signal });
          if (finePointer) {
            host.addEventListener(
              'pointermove',
              (event) => {
                const bounds = host.getBoundingClientRect();
                pointerFieldX = event.clientX - bounds.left;
                pointerFieldY = event.clientY - bounds.top;
                lastPointerMove = performance.now();
                if (easedX < -9000) {
                  easedX = pointerFieldX;
                  easedY = pointerFieldY;
                }
              },
              { passive: true, signal },
            );
            host.addEventListener(
              'pointerleave',
              () => {
                pointerFieldX = -9999;
                pointerFieldY = -9999;
              },
              { signal },
            );
          }
          const fieldObserver = new IntersectionObserver(([entry]) => {
            inView = entry?.isIntersecting ?? true;
            if (inView && animate && !fieldFrame && width) {
              fieldFrame = window.requestAnimationFrame(loop);
            }
          });
          fieldObserver.observe(host);
          document.addEventListener(
            'visibilitychange',
            () => {
              if (!document.hidden && inView && animate && !fieldFrame && width) {
                fieldFrame = window.requestAnimationFrame(loop);
              }
            },
            { signal },
          );
          signal.addEventListener(
            'abort',
            () => {
              fieldObserver.disconnect();
              window.cancelAnimationFrame(fieldFrame);
            },
            { once: true },
          );
        }
      };

      document.addEventListener('astro:page-load', setupPortfolioUI);
    </script>
  </body>
</html>
