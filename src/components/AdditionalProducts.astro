---
import { additionalProducts } from '@/data/additionalProducts';
import ArrowIcon from './ArrowIcon.astro';
import AppImage from './AppImage.astro';
---

<div class="additional-grid">
  {
    additionalProducts.map((project) => (
      <article class="product-highlight" data-reveal>
        <div class="product-highlight__topline">
          <span>Independent product</span>
          <span>{project.platform}</span>
        </div>
        <div class="product-highlight__media">
          <AppImage src={project.image} alt={project.imageAlt} />
        </div>
        <div class="product-highlight__copy">
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="tag-list" aria-label={`${project.name} technologies`}>
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <a class="text-link" href={project.link} target="_blank" rel="noreferrer">
            {project.linkLabel} <ArrowIcon />
          </a>
        </div>
      </article>
    ))
  }
</div>
