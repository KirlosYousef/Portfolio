---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
}
const { eyebrow, title, description, theme = 'light' } = Astro.props;
---

<header class:list={['section-intro', `section-intro--${theme}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-intro__description">{description}</p>}
</header>
